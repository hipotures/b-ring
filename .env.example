# Copy to `.env` (gitignored) and fill in your local device/server details.
ADB_BIN=$HOME/Android/Sdk/platform-tools/adb
ADB_PHONE_IP=192.0.2.10
ADB_PHONE_SERIAL=YOUR_PHONE_SERIAL
ADB_WIFI_SSID=your-wifi-ssid

RING_DEV_URL=https://192.0.2.15:7443
RING_DESKTOP_URL=https://192.0.2.100:7443
RING_DB=$HOME/.local/share/bring/ring.db
